{
  "name": "food-buttons",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hebrew RTL food app: order from Sharon or cook with Thermomix, compare prices. Static site served by a tiny Node server.",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "build": "node tools/build-data.js && node tools/build-sw.js",
    "build:data": "node tools/build-data.js",
    "build:sw": "node tools/build-sw.js"
  },
  "engines": {
    "node": ">=22"
  }
}
