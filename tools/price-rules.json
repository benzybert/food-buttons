      "יסמין",
      "פריך",
      "אטריות",
      "פתיתים"
    ]
  },
  "couscous": {
    "exclude": [
      "פתיתים",
      "פתיתי",
      "מלא"
    ]
  },
  "lentils-green": {
    "exclude": [
      "שחורות",
      "בלוגה",
      "מבושלות",
      "אדומים",
      "אדומות",
      "כתומות"
    ]
  },
  "yeast": {
    "exclude": [
      "טריים"
    ]
  },
  "peas-frozen": {
    "exclude": [
      "וגזר",
