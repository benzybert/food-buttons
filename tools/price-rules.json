    ]
  },
  "white-cheese": {
    "exclude": [
      "תוספת",
      "שמנת"
    ]
  },
  "almonds": {
    "exclude": [
      "ממתק",
      "מצופה",
      "מצופים",
      "חמאת"
    ]
  },
  "peanuts": {
    "exclude": [
      "מצופ",
      "מצופה",
      "מצופים",
      "בקליפה",
      "חמאת"
    ]
  },
  "mushroom": {
    "packaged": true
  },
  "cherry-tomato": {
    "packaged": true
  },
  "parsley": {
    "packaged": true
  },
  "cilantro": {
    "packaged": true
  },
  "dill": {
    "packaged": true
  },
  "mint": {
    "packaged": true
  },
  "basil": {
