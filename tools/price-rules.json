{
  "_comment": "Matching rules for tools/ingest-prices.js, per ingredient id. only = match these phrases instead of the name and aliases; include = extra phrases; exclude = words that mean another product; barcodes = manufacturer barcodes that are this ingredient; packaged = a loose (per kg) ingredient may also be priced from packs with a weight in the name (otherwise only items sold by weight count). No prices here.",
  "oil": {
    "only": [
      "שמן קנולה",
      "שמן צמחי",
      "שמן חמניות",
      "שמן סויה",
      "שמן תירס",
      "שמן לטיגון"
    ]
  },
  "vanilla": {
    "only": [
      "תמצית וניל"
    ]
  },
  "dark-chocolate": {
    "only": [
      "שוקולד מריר",
      "שוקולד מריר פרווה"
    ]
  },
  "pepper": {
    "only": [
      "פלפל שחור",
      "פלפל שחור גרוס",
      "פלפל שחור טחון"
    ]
  },
  "sugar": {
    "exclude": [
      "וניל",
      "חום",
      "דמררה",
      "קנים",
      "אבקת"
    ]
  },
  "salt": {
